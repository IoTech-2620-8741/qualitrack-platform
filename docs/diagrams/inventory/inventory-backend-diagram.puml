    }
  }
  
  package "inventory.infrastructure.persistence.jpa.repositories" {
    interface InventoryMaterialPersistenceRepository
    interface InventoryMovementPersistenceRepository
    interface InventoryReceiptPersistenceRepository
  }
  
}

