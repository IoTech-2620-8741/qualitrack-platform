@startuml iam-database-diagram

title QualiTrack - IAM Database Diagram

hide methods
hide stereotypes

entity "iam_users" {
  * id : BIGINT PK
  --
  created_at : DATETIME NOT NULL
  updated_at : DATETIME NOT NULL
  username : VARCHAR(80) NOT NULL UNIQUE
  email : VARCHAR(120) UNIQUE
  password : VARCHAR(255) NOT NULL
  laboratory_id : BIGINT
  status : VARCHAR(50) NOT NULL
  password_change_required : BOOLEAN NOT NULL
}

entity "iam_roles" {
  * id : BIGINT PK
  --
  created_at : DATETIME NOT NULL
  updated_at : DATETIME NOT NULL
  name : VARCHAR(80) NOT NULL UNIQUE
}

entity "iam_user_roles" {
  * user_id : BIGINT FK
  * role_id : BIGINT FK
}

entity "iam_password_recoveries" {
  * id : BIGINT PK
  --
  created_at : DATETIME NOT NULL
  updated_at : DATETIME NOT NULL
  user_id : BIGINT NOT NULL
  code_hash : VARCHAR(255) NOT NULL
  requested_at : DATETIME NOT NULL
  expires_at : DATETIME NOT NULL
  failed_attempts : INT NOT NULL
  status : VARCHAR(20) NOT NULL
  completed_at : DATETIME
}

iam_users ||--o{ iam_user_roles : user_id
iam_users ||--o{ iam_password_recoveries : user_id
iam_roles ||--o{ iam_user_roles : role_id

entity "iam_edge_gateway_api_keys" {
  * id : BIGINT PK
  --
  created_at : DATETIME NOT NULL
  updated_at : DATETIME NOT NULL
  equipment_id : BIGINT NOT NULL UNIQUE
  api_key_hash : VARCHAR(255) NOT NULL
}
note bottom of iam_edge_gateway_api_keys
  One API key per Edge Gateway; equipment_id is the equipment of Equipment
  Management (no foreign key across bounded contexts). Only the BCrypt hash
  is stored. Created on the deployed database by
  docs/migrations/2026-11-13-01-edge-gateway-api-keys.sql.
end note

@enduml