# Environment variables of the QualiTrack Platform API.
# Copy this file to .env, set your values and pass it with `docker run --env-file .env` (or export the variables in
# your shell or IDE run configuration). Never commit .env: it is ignored by Git.

# Profile: dev (default, local MySQL) or prod (the Docker image runs with prod).
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# MySQL database
DATABASE_URL=localhost
DATABASE_PORT=3306
DATABASE_NAME=qualitrack
DATABASE_USER=root
DATABASE_PASSWORD=change-me

# Required: secret that signs the JWT of the sessions (use a long random value)
JWT_SECRET=replace-with-a-long-random-secret

# Stripe (subscriptions). Use the test keys of your Stripe account outside production.
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
# Prices of the plans; when they are not set, the prices of the Stripe test account are used.
# STRIPE_PRICE_BASIC_MONTHLY=
# STRIPE_PRICE_BASIC_YEARLY=
# STRIPE_PRICE_ENTERPRISE_MONTHLY=
# STRIPE_PRICE_ENTERPRISE_YEARLY=

# Web front of the prod profile: links of the e-mails, Stripe return URLs and CORS. They default to the Firebase
# Hosting site; the dev profile always uses http://localhost:4200.
# APPLICATION_FRONTEND_URL=https://qualitrack-iotech.web.app
# APPLICATION_CORS_ALLOWED_ORIGINS=https://qualitrack-iotech.web.app,https://qualitrack-iotech.firebaseapp.com

# Transactional e-mails (staff credentials, password recovery): Resend, or SMTP when there is no Resend key
RESEND_API_KEY=
QUALITRACK_MAIL_FROM=
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
