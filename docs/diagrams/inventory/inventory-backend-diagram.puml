@startuml inventory-backend-diagram
title QualiTrack - Inventory Backend Class Diagram

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members
skinparam nodesep 25
skinparam ranksep 50

package "shared" <<External>> {
  abstract class AbstractDomainAggregateRoot
  abstract class AuditableAbstractPersistenceEntity {
    -id: Long
    -createdAt: Date
    -updatedAt: Date
  }
  class StockUnit
  interface CurrentUser
  class Result
  class ApplicationError
  class ApplicationException
  class ResponseEntityAssembler
}
package "spring and java.time" <<External>> {
  interface JpaRepository
  interface ApplicationEventPublisher
  abstract class Clock
}
package "batch" <<External>> {
  interface BatchContextFacade
  class ReceiptConsumedEventHandler
  interface RawMaterialUsageRepository
}
package "laboratory.interfaces.acl" <<External>> {
  interface LaboratoryContextFacade
  interface LegacyInventoryFacade
}























package "inventory.interfaces" as Inventoryinterfaces {
  package "inventory.interfaces.acl" {
    class InventoryTenantResourceLookup
    interface InventoryContextFacade {
      +consume(request: ConsumptionRequest): Consumption
      +isRawMaterialInEnvironment(laboratoryId, environmentId, rawMaterialId): boolean
      +findRawMaterialEnvironment(laboratoryId, rawMaterialId): Optional<Long>
    }
    class "InventoryContextFacade.ConsumptionRequest" as ConsumptionRequest <<record>>
    class "InventoryContextFacade.Consumption" as Consumption <<record>>
  }
  
  package "inventory.interfaces.events" {
    class ReceiptConsumedIntegrationEvent <<record>> {
      +receiptId: Long
      +materialId: Long
      +materialName: String
      +productBatchId: Long
      +amount: BigDecimal
      +unit: String
      +stockBefore: BigDecimal
      +stockAfter: BigDecimal
      +occurredAt: Instant
    }
  }
  
  package "inventory.interfaces.rest" {
    class EnvironmentInventoryController {
      +registerRawMaterial(laboratoryId, environmentId, resource)
      +getRawMaterials(laboratoryId, environmentId, stockStatus)
      +getRawMaterial(laboratoryId, environmentId, rawMaterialId)
      +updateRawMaterial(laboratoryId, environmentId, rawMaterialId, resource)
      +getStock(laboratoryId, environmentId, rawMaterialId)
      +receiveBatch(laboratoryId, environmentId, rawMaterialId, resource)
      +getBatches(laboratoryId, environmentId, rawMaterialId, usable)
      +getBatch(laboratoryId, environmentId, rawMaterialId, rawMaterialBatchId)
      +reviewBatch(laboratoryId, environmentId, rawMaterialId, rawMaterialBatchId, resource)
      +getMovements(laboratoryId, environmentId, rawMaterialId)
      +getEnvironmentBatches(laboratoryId, environmentId, expirationStatus, withinDays)
      +importRawMaterial(laboratoryId, environmentId, resource)
    }
    class InventoryController <<legacy preview>> {
      +pending(laboratoryId)
    }
    class InventoryExceptionHandler
  }
  
  package "inventory.interfaces.rest.resources" {
    class ImportRawMaterialResource <<record>>
    class RawMaterialBatchReviewResource <<record>>
    class RawMaterialStockResource <<record>>
    class InventoryMovementResource <<record>>
    class LegacyMaterialResource <<record>>
    class RawMaterialResource <<record>>
    class ReceiptResource <<record>>
    class ReceiveRawMaterialBatchResource <<record>>
    class ReviewRawMaterialBatchResource <<record>>
    class SaveRawMaterialResource <<record>>
  }
  
  package "inventory.interfaces.rest.transform" {
    class InventoryMovementResourceFromEntityAssembler
    class LegacyMaterialResourceFromEntityAssembler
    class RawMaterialBatchReviewResourceFromEntityAssembler
    class RawMaterialResourceFromEntityAssembler
    class ReceiptResourceFromEntityAssembler
    class ReceiveRawMaterialBatchCommandFromResourceAssembler
    class ReviewRawMaterialBatchCommandFromResourceAssembler
    class SaveRawMaterialCommandFromResourceAssembler
  }
  
}

package "inventory.application" as Inventoryapplication {
  package "inventory.application.acl" {
    class InventoryContextFacadeImpl
  }
  
  package "inventory.application.commandservices" {
    interface InventoryCommandService {
      +handle(SaveRawMaterialCommand): Result
      +handle(ReceiveRawMaterialBatchCommand): Result
      +handle(ReviewRawMaterialBatchCommand): Result<RawMaterialBatchReview>
      +handle(ConsumeRawMaterialBatchCommand): Result
    }
    interface InventoryImportService {
      +handle(ImportLegacyRawMaterialCommand): Long
    }
  }
  
  package "inventory.application.internal.commandservices" {
    class InventoryCommandServiceImpl
    class InventoryImportServiceImpl
  }
  
  package "inventory.application.internal.outboundservices" {
    class InventoryMovementRecorder
    class InventoryExternalLaboratoryService
  }
  
  package "inventory.application.internal.queryservices" {
    class InventoryQueryServiceImpl
  }
  
  package "inventory.application.queryservices" {
    interface InventoryQueryService {
      +handle(GetPendingLegacyMaterialsQuery): List<LegacyInventoryFacade.Material>
      +handle(GetEnvironmentRawMaterialsQuery): List<MaterialStockSummary>
      +handle(GetEnvironmentRawMaterialByIdQuery): Optional<MaterialStockSummary>
      +handle(GetRawMaterialBatchesQuery): List<RawMaterialBatch>
      +handle(GetRawMaterialBatchByIdQuery): Optional<RawMaterialBatch>
      +handle(GetRawMaterialMovementsQuery): List<InventoryMovement>
      +handle(GetEnvironmentRawMaterialBatchesQuery): List<RawMaterialBatch>
    }
  }
  
}

package "inventory.domain" as Inventorydomain {
  package "inventory.domain.model.aggregates" {
    class RawMaterial {
      -id: Long
      -laboratoryId: Long
      -environmentId: Long
      -code: String
      -name: String
      -unit: String
      -minimumStock: BigDecimal
      +belongsToEnvironment(environmentId: Long): boolean
      +usableStock(receipts: List<RawMaterialBatch>, onDate: LocalDate): BigDecimal
    }
    class RawMaterialBatch {
      -id: Long
      -laboratoryId: Long
      -rawMaterialId: Long
      -supplier: String
      -batchNumber: String
      -unit: String
      -initialAmount: BigDecimal
      -availableAmount: BigDecimal
      -receivedOn: LocalDate
      -expiresOn: LocalDate
      -status: RawMaterialBatchStatus
      {static} +receive(...): RawMaterialBatch
      +isUsableOn(onDate: LocalDate): boolean
      +expirationStatus(onDate: LocalDate, nearExpiryDays: int): ExpirationStatus
      +release(): void
      +observe(): void
      +reject(): void
      +consume(amount: BigDecimal, requestedUnit: String, onDate: LocalDate): void
    }
  }
  
  package "inventory.domain.model.commands" {
    class ConsumeRawMaterialBatchCommand <<record>> {
      +laboratoryId: Long
      +rawMaterialBatchId: Long
      +productBatchId: Long
      +amountUsed: BigDecimal
      +unit: String
      +operationId: String
    }
    class ImportLegacyRawMaterialCommand <<record>> {
      +laboratoryId: Long
      +environmentId: Long
      +legacyId: Long
    }
    class ReceiveRawMaterialBatchCommand <<record>> {
      +laboratoryId: Long
      +environmentId: Long
      +materialId: Long
      +supplier: String
      +batchNumber: String
      +unit: String
      +amount: java.math.BigDecimal
      +receivedOn: java.time.LocalDate
      +expiresOn: java.time.LocalDate
    }
    class ReviewRawMaterialBatchCommand <<record>> {
      +laboratoryId: Long
      +environmentId: Long
      +materialId: Long
      +receiptId: Long
      +status: com.iotech.qualitrack.platform.inventory.domain.model.valueobjects.RawMaterialBatchStatus
      +reason: String
    }
    class SaveRawMaterialCommand <<record>> {
      +laboratoryId: Long
      +environmentId: Long
      +materialId: Long
      +code: String
      +name: String
      +unit: String
      +minimumStock: java.math.BigDecimal
    }
  }
  
  package "inventory.domain.model.entities" {
    class InventoryMovement <<record>> {
      +id: Long
      +laboratoryId: Long
      +materialId: Long
      +receiptId: Long
      +productBatchId: Long
      +type: String
      +amount: BigDecimal
      +unit: String
      +stockBefore: BigDecimal
      +stockAfter: BigDecimal
      +statusBefore: String
      +statusAfter: String
      +reason: String
      +actorId: Long
      +occurredAt: Instant
      +operationId: String
    }
  }
  
  package "inventory.domain.model.queries" {
    class GetPendingLegacyMaterialsQuery <<record>> {
      +laboratoryId: Long
    }
    class GetEnvironmentRawMaterialsQuery <<record>>
    class GetEnvironmentRawMaterialByIdQuery <<record>>
    class GetRawMaterialBatchesQuery <<record>>
    class GetRawMaterialBatchByIdQuery <<record>>
    class GetRawMaterialMovementsQuery <<record>>
    class GetEnvironmentRawMaterialBatchesQuery <<record>>
  }
  
  package "inventory.domain.model.valueobjects" {
    class MaterialStockSummary <<record>> {
      +id: Long
      +laboratoryId: Long
      +environmentId: Long
      +code: String
      +name: String
      +unit: String
      +minimumStock: BigDecimal
      +usableStock: BigDecimal
      +physicalStock: BigDecimal
      +legacyId: Long
      +stockStatus(): StockStatus
    }
    enum StockStatus {
      LOW
      SUFFICIENT
    }
    enum ExpirationStatus {
      VALID
      NEAR_EXPIRY
      EXPIRED
    }
    class NearExpiryPeriod <<record>>
    class RawMaterialBatchReview <<record>>
    enum RawMaterialBatchStatus {
      QUARANTINED
      RELEASED
      OBSERVED
      REJECTED
    }
    class ReceiptConsumption <<record>> {
      +rawMaterialBatchId: Long
      +productBatchId: Long
      +amountUsed: BigDecimal
      +unit: String
      +stockBefore: BigDecimal
      +stockAfter: BigDecimal
      +operationId: String
    }
  }
  
  package "inventory.domain.repositories" {
    interface InventoryRepository
  }
  
}

package "inventory.infrastructure" as Inventoryinfrastructure {
  package "inventory.infrastructure.configuration" {
