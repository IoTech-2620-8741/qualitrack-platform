      -materialId: Long
      -receiptId: Long
      -productBatchId: Long
      -type: String
      -amount: BigDecimal
      -unit: String
      -stockBefore: BigDecimal
      -stockAfter: BigDecimal
      -statusBefore: String
      -statusAfter: String
      -reason: String
      -actorId: Long
      -occurredAt: Instant
      -operationId: String
    }
    class InventoryReceiptEntity {
      -laboratoryId: Long
      -materialId: Long
      -supplier: String
